<h2><%= @selected_profile.nickname %> さんの脈拍履歴</h2>

<table>
  <tr>
    <th>脈拍</th>
    <th>測定日時</th>
  </tr>
  <% @pulses.each do |p| %>
    <%# pulse が入力されている場合のみ表示 %>
    <% if p.pulse.present? %>
      <tr>
        <td><%= p.pulse %> </td>
        <td><%= p.measured_at.strftime("%Y-%m-%d %H:%M") if p.measured_at.present? %></td>
      </tr>
    <% end %>
  <% end %>
</table>