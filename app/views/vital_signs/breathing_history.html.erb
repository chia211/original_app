<h2><%= @selected_profile.nickname %> さんの酸素濃度履歴</h2>

<table>
  <tr>
    <th>酸素</th>
    <th>測定日時</th>
  </tr>
  <% @breathings.each do |br| %>
    <%# breathing が入力されている場合のみ表示 %>
    <% if br.breathing.present? %>
      <tr>
        <td><%= br.breathing %></td>
        <td><%= br.measured_at.strftime("%Y-%m-%d %H:%M") if br.measured_at.present? %></td>
      </tr>
    <% end %>
  <% end %>
</table>