<h2><%= @selected_profile.nickname %> さんの体温履歴</h2>

<table>
  <tr>
    <th>体温</th>
    <th>測定日時</th>
  </tr>
  <% @temperatures.each do |tem| %>
    <%# body_temperature が入力されている場合のみ表示 %>
    <% if tem.body_temperature.present? %>
      <tr>
        <td><%= tem.body_temperature %></td>
        <td><%= tem.measured_at.strftime("%Y-%m-%d %H:%M") if tem.measured_at.present?%></td>
      </tr>
    <% end %>
<% end %>
</table>